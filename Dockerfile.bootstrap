#
# First-party bootstrap image for the chart's TLS hooks (internal-tls-job, webhook-cert-job).
#
# WHY THIS EXISTS. Those hooks need BOTH `kubectl` (to patch the webhook caBundle / write the TLS
# Secret) and `openssl` (to self-sign the internal CA). The previous image, alpine/k8s, ships kubectl
# but NOT openssl — verified, not assumed:
#
#     docker run --entrypoint /bin/sh alpine/k8s:1.30.0 -c 'which openssl'   ->  not found
#
# so the hooks fell back to `apk add --no-cache openssl` at runtime, which requires writing the
# package DB, which requires root. That `runAsUser: 0` is rejected outright by OpenShift's default
# restricted-v2 SCC, so `helm install` died at the pre-install hook — nothing deployed at all.
#
# Baking both tools in removes the runtime `apk add`, and with it the only reason these hooks needed
# root. It also removes a network dependency from the install path: a hook that apk-adds at runtime
# fails in an air-gapped or egress-restricted cluster, which is a common posture for the sort of
# environment that runs a policy-enforcement product.
#
# OPENSHIFT / ARBITRARY UID. OpenShift assigns a random UID from the namespace's allocated range
# (typically ~1000650000+) with GID 0. An image that only works as one specific UID breaks there. So:
# nothing here is owned by a fixed user, the working directory is group-writable by GID 0, and the
# default USER is numeric (not a name) so `runAsNonRoot: true` can verify it without a lookup.
# The chart omits runAsUser entirely when openshift.enabled=true, letting the platform assign.

ARG ALPINE_VERSION=3.21
FROM alpine:${ALPINE_VERSION}

# kubectl is fetched rather than apk-installed: Alpine's community repo lags upstream, and the hooks
# talk to whatever API server the chart is installed against. Pinned + checksum-verified below.
ARG KUBECTL_VERSION=v1.31.4
ARG TARGETARCH

# ca-certificates: kubectl must verify the API server's serving cert.
# openssl: the entire reason this image exists.
RUN apk add --no-cache ca-certificates openssl \
    && rm -rf /var/cache/apk/*

# Download kubectl for the BUILD's target architecture (buildx sets TARGETARCH per platform, so the
# same Dockerfile produces correct amd64 and arm64 variants) and verify it against the checksum
# published alongside it. An unverified curl|install into a cluster-admin-capable hook would be a
# supply-chain hole in the one component that patches a webhook's caBundle.
RUN set -eu; \
    arch="${TARGETARCH:-amd64}"; \
    base="https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}"; \
    wget -q -O /tmp/kubectl "${base}/kubectl"; \
    wget -q -O /tmp/kubectl.sha256 "${base}/kubectl.sha256"; \
    echo "$(cat /tmp/kubectl.sha256)  /tmp/kubectl" | sha256sum -c -; \
    install -m 0755 /tmp/kubectl /usr/local/bin/kubectl; \
    rm -f /tmp/kubectl /tmp/kubectl.sha256; \
    kubectl version --client=true --output=yaml >/dev/null

# kubectl writes a discovery/HTTP cache and needs a HOME it can write to. Under OpenShift the runtime
# UID is unpredictable but GID is always 0, so make these group-writable rather than owned by a user.
# Callers still point HOME/KUBECACHEDIR at a tmpfs mount (see the chart's read-only-rootfs contract);
# this is the fallback that keeps the image usable if they don't.
RUN mkdir -p /workspace \
    && chgrp -R 0 /workspace \
    && chmod -R g=u /workspace
WORKDIR /workspace
ENV HOME=/workspace \
    KUBECACHEDIR=/workspace/.kube/cache

# Numeric so `runAsNonRoot: true` can enforce it without resolving a name. OpenShift overrides this
# with its own allocated UID, which still lands in GID 0 and so retains access to /workspace.
USER 65532:0

ENTRYPOINT ["/bin/sh"]
