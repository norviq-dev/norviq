# SPDX-License-Identifier: Apache-2.0
# Multi-stage build for minimal image

FROM python:3.15-slim AS builder
WORKDIR /build
COPY pyproject.toml .
COPY norviq/ norviq/
# [spiffe] extra installs pyspiffe so NRVQ_SPIFFE_MODE=workload-api works (import-guarded; mock unaffected).
RUN pip install --no-cache-dir --target=/deps '.[spiffe]'

FROM python:3.15-slim
WORKDIR /app
COPY --from=builder /deps /usr/local/lib/python3.12/site-packages
# Nothing in the runtime image installs packages (the dependencies arrive above from the builder's
# /deps), so drop the base image's own pip: it is never used here and only carries scanner findings.
# The ensurepip wheel is the same pip, so it goes too. The `import pip` check fails the build if a
# copied-in dependency ever brings pip back.
RUN python -m pip uninstall -y --root-user-action=ignore pip && \
    rm -f /usr/local/lib/python3.12/ensurepip/_bundled/pip-*.whl && \
    ! python -c "import pip" 2>/dev/null
COPY norviq/ norviq/
COPY policies/ policies/
# Kept in step with Dockerfile.api: the engine imports the same norviq.api package tree, so the
# baseline compiler must be able to find the presets here too rather than raising FileNotFoundError.
COPY webhook/presets/ webhook/presets/

# OPA arch matches the build target (TARGETARCH = amd64|arm64; AKS=amd64, local kind on Apple Silicon=arm64).
ARG TARGETARCH=amd64
# Build-provenance stamp (broadcast by CI: build.yml build-args NRVQ_GIT_SHA=github.sha).
ARG NRVQ_GIT_SHA=unknown
# Install the OPA binary so the `subprocess` rollback mode works in-cluster (server mode uses the
# OPA sidecar and does not need this; kept for parity with Dockerfile.api). Pinned to the same version
# as the Helm sidecar image (openpolicyagent/opa:1.21.4-static) and integrity-checked against the
# published SHA256 digest so a compromised/mismatched download fails the build closed instead of
# silently installing an unverified decision-engine binary.
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    case "${TARGETARCH}" in \
        amd64) OPA_SHA256="2ab571f367f293bb19523b76f92f1945bbf245003392c7f392903f95c2b9b630" ;; \
        arm64) OPA_SHA256="810aa96e44f1f852d044888cf830324e44eafd0f510345339011347ab4deaab1" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fL --retry 5 --retry-all-errors --retry-delay 3 --connect-timeout 15 --max-time 180 \
        -o /usr/local/bin/opa "https://openpolicyagent.org/downloads/v1.21.4/opa_linux_${TARGETARCH}_static" && \
    echo "${OPA_SHA256}  /usr/local/bin/opa" | sha256sum -c - && \
    chmod +x /usr/local/bin/opa && \
    opa version && \
    apt-get remove -y curl && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Uniform build provenance across ALL shipped images (mirrors Dockerfile.api:24-25,56), not just
# api. Stamped AFTER the OPA layer so changing the SHA busts only these trivial layers, never the OPA
# download cache. NRVQ_BUILD_GIT_SHA is the runtime NO-STALE marker; the label is the OCI revision.
ENV NRVQ_BUILD_GIT_SHA=${NRVQ_GIT_SHA}
LABEL org.opencontainers.image.revision=${NRVQ_GIT_SHA} \
      org.opencontainers.image.licenses=Apache-2.0
RUN printf "%s\n" "${NRVQ_GIT_SHA}" > /app/.build_git_sha

# Pin a NUMERIC uid and reference it numerically in USER so kubelet can verify the
# securityContext runAsNonRoot=true (a name-based `USER norviq` fails with "non-numeric user").
RUN useradd -r -u 999 -s /usr/sbin/nologin norviq
USER 999

EXPOSE 8282
ENV NRVQ_SOCKET_PATH=/tmp/norviq-proxy.sock
ENV NRVQ_HTTP_FALLBACK_PORT=8282

CMD ["python", "-m", "norviq.sidecar"]
