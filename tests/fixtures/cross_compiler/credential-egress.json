      "decision": "block",
      "reason": "not permitted by this intent"
    },
    "allowlist": {
      "tools": [
        "send_email"
      ],
      "refinements": {
        "readonly": false,
        "egress": false,
        "scope": false,
        "rate": false
      },
      "grants": [
        {
          "tool": "send_email",
          "constraints": [],
          "facts": [
            {
              "type": "collectionFact",
              "field": "data_classes",
              "op": "noneOf",
              "values": [
                "secret"
              ]
            },
            {
              "type": "collectionFact",
              "field": "destinations.emails",
              "op": "subsetOf",
              "values": [
                "ops@acme.com"
              ]
            }
          ]
        }
      ]
    }
  },
  "cases": [
