{
  "name": "credential-egress",
  "why": "A credential in the payload must deny regardless of tool name, and the recipient must stay in-domain. Recorded live: a bare AWS key reached an attacker address while a card number in the same position blocked. This fixture previously had NO builder half \u2014 closing that gap is what grant `facts` are for, so it now pins both compilers.",
  "intent": {
    "name": "no-secret-egress",
    "class": "report-gen",
    "call": [
      {
        "id": "mail-acme",
        "match": {
          "tool_name": "send_email"
        },
        "require": {
          "data_classes": {
            "noneOf": [
              "secret"
            ]
          },
          "destinations.emails": {
            "subsetOf": [
              "ops@acme.com"
            ]
          }
        }
      }
    ]
  },
  "graph": {
    "schemaVersion": 1,
    "scope": {
      "kind": "class",
      "agentClass": "report-gen"
    },
    "mode": "allowlist",
    "rules": [],
