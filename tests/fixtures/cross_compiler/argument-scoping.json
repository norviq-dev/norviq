{
  "name": "argument-scoping",
  "why": "The claim both compilers exist to make: a listed tool is admitted only for the ARGUMENTS stated.",
  "intent": {
    "name": "select-only",
    "class": "report-gen",
    "call": [
      {
        "id": "select-only",
        "match": {
          "tool_name": "execute_sql"
        },
        "require": {
          "param_paths.query": {
            "matches": "(?i)^\\s*select\\b"
          }
        }
      }
    ]
  },
  "graph": {
    "schemaVersion": 1,
    "scope": {
      "kind": "class",
      "agentClass": "report-gen"
    },
    "mode": "allowlist",
    "rules": [],
