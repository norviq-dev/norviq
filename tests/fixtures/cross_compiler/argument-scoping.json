      "decision": "block",
      "reason": "not in the allowlist"
    },
    "allowlist": {
      "tools": [
        "execute_sql"
      ],
      "refinements": {
        "readonly": false,
        "egress": false,
        "scope": false,
        "rate": false
      },
      "grants": [
        {
          "tool": "execute_sql",
          "constraints": [
            {
              "kind": "matches",
              "field": "query",
              "pattern": "(?i)^\\s*select\\b"
            }
          ]
        }
      ]
    }
  },
