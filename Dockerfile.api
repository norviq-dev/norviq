# SPDX-License-Identifier: Apache-2.0
# Multi-stage build for minimal image

FROM python:3.12-slim AS builder
WORKDIR /build
COPY pyproject.toml .
COPY norviq/ norviq/
# [spiffe] extra installs pyspiffe so NRVQ_SPIFFE_MODE=workload-api works (import-guarded; mock unaffected).
RUN pip install --no-cache-dir --target=/deps '.[spiffe]' uvicorn

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /deps /usr/local/lib/python3.12/site-packages

# OPA arch matches the build target (TARGETARCH = amd64|arm64; AKS=amd64, local kind on Apple Silicon=arm64).
ARG TARGETARCH=amd64
ARG NRVQ_GIT_SHA=unknown
ENV NRVQ_BUILD_GIT_SHA=${NRVQ_GIT_SHA}
LABEL org.opencontainers.image.revision=${NRVQ_GIT_SHA}
# Install OPA binary, pinned to the same version as the Helm sidecar image
# (openpolicyagent/opa:1.19.0-static) and integrity-checked against the published SHA256 digest so a
# compromised/mismatched download fails the build closed instead of silently installing an
# unverified decision-engine binary.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    case "${TARGETARCH}" in \
        amd64) OPA_SHA256="1dd5c5591ff856f5e20a1d66bafae9511ddf3c5552ed3b5070c70b2b6580ee3f" ;; \
        arm64) OPA_SHA256="06680087ed236c8c6aaa021660d83178db829a2ad30bdb3482481fada6791b2a" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fL -o /usr/local/bin/opa "https://openpolicyagent.org/downloads/v1.19.0/opa_linux_${TARGETARCH}_static" && \
    echo "${OPA_SHA256}  /usr/local/bin/opa" | sha256sum -c - && \
    chmod +x /usr/local/bin/opa && \
    opa version && \
    apt-get remove -y curl && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

RUN /usr/local/bin/opa version

# Build provenance stamp: changing NRVQ_GIT_SHA invalidates downstream COPY cache.
RUN printf "%s\n" "${NRVQ_GIT_SHA}" > /app/.build_git_sha

COPY norviq/ norviq/
COPY policies/ policies/
# The baseline compiler (norviq/api/baseline.py) reads the shipped presets to rebuild a namespace's
# control set, so the API image needs them too — they were previously only in the webhook image.
# Copied from their authoring location rather than duplicated under policies/: this repo already
# maintains one preset in two places (comprehensive.rego vs strict.rego) and the drift guard for that
# pair only runs under `opa test`, never in-cluster.
COPY webhook/presets/ webhook/presets/

# Pin a NUMERIC uid and reference it numerically in USER so kubelet can verify the
# securityContext runAsNonRoot=true (a name-based `USER norviq` fails with "non-numeric user").
RUN useradd -r -u 999 -s /usr/sbin/nologin norviq
USER 999

EXPOSE 8080
# --workers. Without it uvicorn runs ONE event loop per pod, so a pod serves one request at a time no
# matter how much CPU it is given — and /api/v1/evaluate sits in front of every agent tool call.
#
# Measured in-cluster before this change (2 replicas, benign search_kb, 60 calls per level): p50 rose
# 66ms -> 131ms -> 291ms at concurrency 1/2/4, linearly, which is a queue in front of a single server
# rather than expensive work. Past ~4 concurrent it crossed the engine's 2s budget and FAILED CLOSED:
# of 64 identical benign calls at 16-way, 21 returned evaluator_error, 19 trust_frozen, 19
# evaluator_fallback and only 5 were allowed. Ordinary traffic refused because the enforcement point
# ran out of capacity, not because anything was wrong with it.
#
# `sh -c` because a JSON-form CMD does not expand environment variables, and the count has to be
# tunable per deployment — the right number tracks the container's CPU limit, which the chart owns.
# `exec` so uvicorn stays PID 1 and keeps receiving SIGTERM for graceful drain.
#
# ⚠ Each worker is a separate PROCESS with its own memory. Raising this without raising the memory
# limit trades timeouts for OOMKills: measured at 214Mi against a 256Mi limit with ONE worker, i.e.
# 84% full at idle. The chart's api memory limit was raised in the same change.
CMD ["sh", "-c", "exec python -m uvicorn norviq.api.main:app --host 0.0.0.0 --port 8080 --workers ${NRVQ_API_WORKERS:-4}"]
